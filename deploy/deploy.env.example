# Copy to deploy/deploy.env (gitignored) and fill in values.

# GitHub Container Registry (create PAT with read:packages + write:packages)
GITHUB_USER=flamingowinter
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
IMAGE_NAME=bayesian-network-bias-simulation
IMAGE_TAG=latest

# Droplet SSH
DROPLET_HOST=your.droplet.ip
DROPLET_USER=root
# SSH key: use default agent, or set IdentityFile in ~/.ssh/config for this host

CONTAINER_NAME=bias-sim
CONTAINER_PORT=8080

# Baked into the frontend at image build time
VITE_API_URL=https://api.modelling-bias.com/
VITE_WS_URL=wss://api.modelling-bias.com/ws

# Runtime (passed to the container)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.modelling-bias.com,localhost

# Apple Silicon → DigitalOcean amd64 droplet
DOCKER_PLATFORM=linux/amd64
